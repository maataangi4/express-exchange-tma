# Скопируйте в .env.development.local и заполните



# Токен @exexchange_bot (BotFather → API Token)

REACT_APP_BOT_USERNAME=exexchange_bot

REACT_APP_EXEXCHANGE_BOT_TOKEN=123456789:ABCdef...

EXEXCHANGE_BOT_TOKEN=123456789:ABCdef...



# Бот заявок с кнопками Подтвердить / Отменить (ORDERS |NEW ||EX)

ORDERS_BOT_TOKEN=8773403975:AAH...

ORDERS_ADMIN_CHAT_ID=6489489271



# Gemini (бесплатно): https://aistudio.google.com/apikey

GEMINI_API_KEY=AIza...

GEMINI_MODEL=gemini-2.5-flash-lite



# URL мини-приложения для подсказок AI

# Cloudflare quick tunnel: npm run tunnel → скопируйте https://....trycloudflare.com
MINI_APP_URL=https://your-app.trycloudflare.com



# Google Sheets — при «Подтвердить» строка попадает на вкладку Orders_Today NEW

# https://docs.google.com/spreadsheets/d/11p4tMxdnq91JngFwFUFUykcy60Tqxpfyhf1amLGI2v4

GOOGLE_SPREADSHEET_ID=11p4tMxdnq91JngFwFUFUykcy60Tqxpfyhf1amLGI2v4

GOOGLE_SHEET_TAB=Orders_Today NEW

# Путь к JSON service account (Google Cloud → APIs → Sheets → Service Account)

GOOGLE_APPLICATION_CREDENTIALS=server/google-service-account.json

# Или одной строкой (весь JSON):

# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}



BOT_SERVER_PORT=3001

# React → API (dev: можно не задавать — работает proxy в package.json на :3001)
# REACT_APP_BOT_API_URL=http://localhost:3001



# Shipday — при «Подтвердить» курьерские заказы уходят в Shipday (только delivery)

# https://docs.shipday.com/reference/insert-delivery-order

SHIPDAY_API_KEY=

SHIPDAY_RESTAURANT_NAME=Express Exchange

SHIPDAY_RESTAURANT_ADDRESS=Av. Los Incas 3390, Buenos Aires

SHIPDAY_RESTAURANT_PHONE=+5491100000000

SHIPDAY_DEFAULT_PHONE=+5491100000000

